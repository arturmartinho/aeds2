public class SomaDigitos {
    public static int somar(int n) {
        int soma = 0;
        while (n > 0) {
            soma += n % 10;
            n /= 10;
        }
        return soma;
    }

    public static void main(String[] args) {
        MyIO.setCharset("UTF-8");
        int n = MyIO.readInt();
        while (n != -1) {
            MyIO.println(somar(n));
            n = MyIO.readInt();
        }
    }
}
