public class IsRecursivo {
    public static boolean isVogal(String s) {
        return isVogal(s, 0);
    }

    private static boolean isVogal(String s, int i) {
        boolean resp;
        if (i == s.length()) {
            resp = true;
        } else {
            char c = s.charAt(i);
            if (c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' ||
                c == 'A' || c == 'E' || c == 'I' || c == 'O' || c == 'U') {
                resp = isVogal(s, i + 1);
            } else {
                resp = false;
            }
        }
        return resp;
    }

    public static boolean isConsoante(String s) {
        return isConsoante(s, 0);
    }

    private static boolean isConsoante(String s, int i) {
        boolean resp;
        if (i == s.length()) {
            resp = true;
        } else {
            char c = s.charAt(i);
            if ((c >= 'a' && c <= 'z' && c != 'a' && c != 'e' && c != 'i' && c != 'o' && c != 'u') ||
                (c >= 'A' && c <= 'Z' && c != 'A' && c != 'E' && c != 'I' && c != 'O' && c != 'U')) {
                resp = isConsoante(s, i + 1);
            } else {
                resp = false;
            }
        }
        return resp;
    }

    public static boolean isInteiro(String s) {
        return isInteiro(s, 0);
    }

    private static boolean isInteiro(String s, int i) {
        boolean resp;
        if (i == s.length()) {
            resp = true;
        } else {
            char c = s.charAt(i);
            if (i == 0 && (c == '-' || c == '+')) {
                resp = isInteiro(s, i + 1);
            } else if (c >= '0' && c <= '9') {
                resp = isInteiro(s, i + 1);
            } else {
                resp = false;
            }
        }
        return resp && s.length() > 0;
    }

    public static boolean isReal(String s) {
        return isReal(s, 0, 0);
    }

    private static boolean isReal(String s, int i, int pontos) {
        boolean resp;
        if (i == s.length()) {
            resp = (pontos == 1);
        } else {
            char c = s.charAt(i);
            if (i == 0 && (c == '-' || c == '+')) {
                resp = isReal(s, i + 1, pontos);
            } else if (c == '.') {
                resp = isReal(s, i + 1, pontos + 1);
            } else if (c >= '0' && c <= '9') {
                resp = isReal(s, i + 1, pontos);
            } else {
                resp = false;
            }
        }
        return resp && s.length() > 0 && pontos <= 1;
    }

    public static void main(String[] args) {
        MyIO.setCharset("UTF-8");
        String linha = MyIO.readLine();
        while (!linha.equals("FIM")) {
            String vogal = isVogal(linha) ? "SIM" : "NAO";
            String consoante = isConsoante(linha) ? "SIM" : "NAO";
            String inteiro = isInteiro(linha) ? "SIM" : "NAO";
            String real = isReal(linha) ? "SIM" : "NAO";
            MyIO.println(vogal + " " + consoante + " " + inteiro + " " + real);
            linha = MyIO.readLine();
        }
    }
}
